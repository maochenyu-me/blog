{
  "headers": [
    {
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ],
      "source": "/api/*"
    },
    {
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ],
      "source": "*.opml"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "source": "/sw.js"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "source": "/manifest.webmanifest"
    }
  ],
  "redirects": [
    {
      "destination": "https://www.zhilu.site/api/icon",
      "source": "/favicon.ico",
      "status": 308
    }
  ]
}